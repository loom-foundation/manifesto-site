---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import '../styles/global.css';
import faviconUrl from '../../../../../org/brand/assets/favicon.svg?url';
import wordmarkUrl from '../../../../../org/brand/assets/loom-wordmark.png?url';
import wordmarkInvertedUrl from '../../../../../org/brand/assets/loom-wordmark-inverted.png?url';

const brandRoot = resolve(process.cwd(), '../../../org/brand/assets');

let logoSvg = readFileSync(resolve(brandRoot, 'loom-logo.svg'), 'utf-8');
logoSvg = logoSvg.replace(/@font-face\s*\{[\s\S]*?\}/g, '');
logoSvg = logoSvg.replace('stroke="url(#gradInfinity)"', 'id="infinity-path" stroke="url(#gradInfinity)"');

interface Props {
  title: string;
  description: string;
  abstract: string;
  keywords: string;
  canonicalPath?: string;
}

const { title, description, abstract, keywords, canonicalPath } = Astro.props;

const siteUrl = 'https://theloommanifesto.org';
const urlPath = canonicalPath ?? new URL(Astro.request.url).pathname;
const canonical = `${siteUrl}${urlPath === '/' ? '' : urlPath}`;

// Social / link-preview card (1200x630 PNG). Raster, not SVG, so scrapers
// that don't support SVG still render a preview.
const ogImage = `${siteUrl}/og-card.png`;

// The raw-Markdown twin of this page, advertised so agents and crawlers can
// discover the machine-readable source (also served at /manifesto.md).
const markdownAlternate = `${siteUrl}/manifesto.md`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  headline: title,
  description,
  abstract,
  url: canonical,
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: 'Bruno Almeida do Lago', url: 'https://bruno.blissful.im' },
  copyrightYear: 2026,
  copyrightHolder: { '@type': 'Person', name: 'Bruno Almeida do Lago' },
  license: 'https://creativecommons.org/licenses/by-nd/4.0/',
  image: ogImage,
  datePublished: '2026',
  keywords,
  // The machine-readable source, so agents and structured-data consumers
  // can fetch the manifesto verbatim as Markdown rather than scraping HTML.
  encoding: {
    '@type': 'MediaObject',
    encodingFormat: 'text/markdown',
    contentUrl: `${siteUrl}/manifesto.md`,
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme') || 'system';
        if (t !== 'system') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="author" content="Bruno Almeida do Lago" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07132B" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownAlternate} title="The Loom Manifesto (Markdown source)" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="The Loom Manifesto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Loom Manifesto — when machines build at speed, clarity becomes the craft." />
    <meta property="og:locale" content="en_GB" />
    <meta property="article:author" content="https://bruno.blissful.im" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main>
      <div class="top-bar">
        <a href="/" aria-label="The Loom Manifesto" class="wordmark-link">
          <img src={wordmarkUrl} alt="" class="wordmark-img wordmark-img--light" />
          <img src={wordmarkInvertedUrl} alt="" class="wordmark-img wordmark-img--dark" />
        </a>
        <div class="theme-switcher">
          <button class="theme-trigger" aria-label="Color theme" aria-expanded="false" aria-haspopup="menu">
            <span class="theme-icon theme-icon--light" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            </span>
            <span class="theme-icon theme-icon--auto" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </span>
            <span class="theme-icon theme-icon--dark" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </span>
          </button>
          <div class="theme-menu" role="menu">
            <button class="theme-option" data-theme-btn="light" role="menuitem" aria-pressed="false">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
              <span>Day</span>
            </button>
            <button class="theme-option" data-theme-btn="system" role="menuitem" aria-pressed="false">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
              <span>Auto</span>
            </button>
            <button class="theme-option" data-theme-btn="dark" role="menuitem" aria-pressed="false">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
              <span>Night</span>
            </button>
          </div>
        </div>
      </div>
      <header class="masthead">
        <a href="/" aria-label="The Loom Manifesto" class="logo-link">
          <Fragment set:html={logoSvg} />
        </a>
      </header>
      <article class="manifesto">
        <slot />
      </article>
    </main>
    <script>
      const infinityPath = document.getElementById('infinity-path') as SVGPathElement | null;
      if (infinityPath) {
        const len = infinityPath.getTotalLength();
        infinityPath.style.strokeDasharray = String(len);
        infinityPath.style.strokeDashoffset = String(len);
      }

      const triggerBtn = document.querySelector<HTMLButtonElement>('.theme-trigger')!;
      const themeMenu = document.querySelector<HTMLElement>('.theme-menu')!;
      const options = document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]');

      function applyTheme(theme: string) {
        if (theme === 'system') {
          document.documentElement.removeAttribute('data-theme');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
        }
        localStorage.setItem('theme', theme);
        options.forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.dataset.themeBtn === theme));
        });
      }

      function openMenu() {
        themeMenu.classList.add('open');
        triggerBtn.setAttribute('aria-expanded', 'true');
      }

      function closeMenu() {
        themeMenu.classList.remove('open');
        triggerBtn.setAttribute('aria-expanded', 'false');
      }

      triggerBtn.addEventListener('click', () => {
        if (!themeMenu.classList.contains('open')) openMenu();
        else closeMenu();
      });

      options.forEach(btn => {
        btn.addEventListener('click', () => {
          applyTheme(btn.dataset.themeBtn!);
          closeMenu();
        });
      });

      document.addEventListener('click', e => {
        if (themeMenu.classList.contains('open') &&
            !triggerBtn.contains(e.target as Node) &&
            !themeMenu.contains(e.target as Node)) {
          closeMenu();
        }
      });

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeMenu();
      });

      const saved = localStorage.getItem('theme') || 'system';
      applyTheme(saved);
    </script>
  </body>
</html>
